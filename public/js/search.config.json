{
  "use": "client",
  "presets": {
    "client": {
      "fetch": false,
      "layers": [
        {
          "name": "main",
          "flexsearchConfig": {
            "tokenize": "strict",
            "document": {
              "id": "id",
              "index": ["title", "altertitle", "subtitle", "description", "authors"]
            }
          }
        }
      ]
    },
    "server": {
      "fetch": "./tpl/public/index/",
      "layers": [
        {
          "name": "minimal",
          "flexsearchConfig": {
            "tokenize": "forward",
            "document": {
              "id": "id",
              "index": ["title", "altertitle", "subtitle", "authors"]
            }
          }
        },
        {
          "name": "metadata",
          "flexsearchConfig": {
            "tokenize": "strict",
            "document": {
              "id": "id",
              "index": ["keyword", "abstract", "doi", "introduction"]
            }
          }
        },
        {
          "name": "text",
          "flexsearchConfig": {
            "tokenize": "strict",
            "document": {
              "id": "id",
              "index": ["text", "appendix", "notes"]
            }
          }
        }
      ]
    }
  }
}
